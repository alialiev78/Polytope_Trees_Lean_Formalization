module

public import Proofs.BoundaryCut

@[expose] public section

set_option backward.dsimp.instances true

set_option backward.isDefEq.respectTransparency false

/-!
# Exact cut--join with boundary labels

`BoundaryCut` proves an equivalence between a coloured matching with a
distinguished seam and a coloured matching with a selected free pair (and
the remembered seam colour).  This file lifts that equivalence through the
*dependent* type of boundary labellings.

The important point is that after a free pair has been rejoined, its
boundary is again the old boundary.  Consequently the label on the uncut
object must live over the rejoined matching, not over the cut matching.
Encoding exactly that dependency avoids any freeness assumption and also
works unchanged for `m = 0`.
-/

namespace PolytopeCounting
namespace FacetPairing
namespace LabelledCutJoin

noncomputable section

universe uD

variable {D : Type uD} [DecidableEq D] {r m : ℕ}

/-- A boundary-labelled coloured matching together with a distinguished
seam.  The labelling can be the unique empty labelling (`m = 0`). -/
abbrev MarkedBoundaryLabelledPairing
    (D : Type uD) [DecidableEq D] (r m : ℕ) :=
  Σ P : BoundaryLabelledPairing D r m, P.pairing.Seam

/-- Cut data carrying exactly enough information to reconstruct the
boundary-labelled uncut matching.

The boundary label is deliberately attached to `joinSelected w`.  It is
therefore a label of the boundary *after rejoining* the selected free pair,
not a label of all free darts in the cut matching. -/
abbrev RejoinedBoundaryLabelledFreePair
    (D : Type uD) [DecidableEq D] (r m : ℕ) :=
  Σ w : ColoredMatching.FreePairColoredMatching D r,
    (ColoredMatching.joinSelected w).1.Boundary ≃ Fin m

/-- Merely reassociate the fields of a marked boundary-labelled pairing.
No quotient, orbit choice, or freeness hypothesis occurs here. -/
def markedBoundaryLabelledEquivSigma :
    MarkedBoundaryLabelledPairing D r m ≃
      Σ z : ColoredMatching.MarkedColoredMatching D r,
        z.1.Boundary ≃ Fin m where
  toFun
    | ⟨⟨P, label⟩, e⟩ => ⟨⟨P, e⟩, label⟩
  invFun
    | ⟨⟨P, e⟩, label⟩ => ⟨⟨P, label⟩, e⟩
  left_inv
    | ⟨⟨_, _⟩, _⟩ => rfl
  right_inv
    | ⟨⟨_, _⟩, _⟩ => rfl

/-- The exact colour- and boundary-label-preserving cut--join equivalence.

Its base map is the concrete equivalence from `BoundaryCut`; the dependent
labelling fibre is transported by `Equiv.sigmaCongrLeft'`.  Thus transport
is generated by the proved identities
`joinSelected_cutMarked` and `cutMarked_joinSelected`, rather than by an
assumed certificate. -/
def markedBoundaryLabelledEquivRejoinedFreePair :
    MarkedBoundaryLabelledPairing D r m ≃
      RejoinedBoundaryLabelledFreePair D r m :=
  markedBoundaryLabelledEquivSigma.trans <|
    Equiv.sigmaCongrLeft'
      (ColoredMatching.markedColoredEquivFreePair (D := D) (r := r))

/-- Concrete forward cut map of the labelled equivalence. -/
def cutLabelled
    (z : MarkedBoundaryLabelledPairing D r m) :
    RejoinedBoundaryLabelledFreePair D r m :=
  markedBoundaryLabelledEquivRejoinedFreePair z

/-- Concrete inverse join map of the labelled equivalence. -/
def joinLabelled
    (w : RejoinedBoundaryLabelledFreePair D r m) :
    MarkedBoundaryLabelledPairing D r m :=
  markedBoundaryLabelledEquivRejoinedFreePair.symm w

/-- On underlying coloured cut data, `cutLabelled` is literally the
concrete `cutMarked` operation from `BoundaryCut`. -/
@[simp]
theorem cutLabelled_base
    (z : MarkedBoundaryLabelledPairing D r m) :
    (cutLabelled z).1 =
      ColoredMatching.cutMarked ⟨z.1.pairing, z.2⟩ := rfl

/-- Hence the matching in the cut datum is exactly seam erasure. -/
@[simp]
theorem cutLabelled_pairing
    (z : MarkedBoundaryLabelledPairing D r m) :
    (cutLabelled z).1.1 = z.1.pairing.erase z.2 := rfl

/-- The selected unordered pair in the cut datum is exactly the pair of
endpoints exposed by erasure. -/
@[simp]
theorem cutLabelled_selectedPair
    (z : MarkedBoundaryLabelledPairing D r m) :
    (cutLabelled z).1.2.selected.pair = z.2.1 := rfl

/-- The proposed colour in the cut datum is exactly the deleted seam's
colour. -/
@[simp]
theorem cutLabelled_color
    (z : MarkedBoundaryLabelledPairing D r m) :
    (cutLabelled z).1.2.color = z.1.pairing.color z.2 := rfl

/-- Rejoining immediately after a labelled cut recovers every field,
including the dependent boundary equivalence. -/
theorem joinLabelled_cutLabelled
    (z : MarkedBoundaryLabelledPairing D r m) :
    joinLabelled (cutLabelled z) = z :=
  markedBoundaryLabelledEquivRejoinedFreePair.left_inv z

/-- Cutting immediately after a labelled join recovers the selected free
pair, its colour, and the dependent boundary equivalence. -/
theorem cutLabelled_joinLabelled
    (w : RejoinedBoundaryLabelledFreePair D r m) :
    cutLabelled (joinLabelled w) = w :=
  markedBoundaryLabelledEquivRejoinedFreePair.right_inv w

/-! ## Exposing the `m+2` cut boundary

The preceding equivalence is the lossless core.  The next definition also
produces the conventional labelling of every boundary dart of the cut
matching by `Fin (m+2)`.  The two new labels are supplied canonically by
`PartialMatching.cutBoundaryLabel`; no exceptional case is required when
`m = 0`.
-/

/-- Extend the old boundary label across the marked cut, assigning the two
new labels canonically to the exposed endpoints. -/
def canonicalCutBoundaryLabel
    (z : MarkedBoundaryLabelledPairing D r m) :
    (z.1.pairing.erase z.2).Boundary ≃ Fin (m + 2) :=
  z.1.pairing.matching.cutBoundaryLabel z.2 z.1.label

/-- A conventional boundary-labelled cut pairing together with the colour
of the deleted seam. -/
def cutToBoundaryLabelled
    (z : MarkedBoundaryLabelledPairing D r m) :
    BoundaryLabelledPairing D r (m + 2) × Fin r :=
  (⟨z.1.pairing.erase z.2, canonicalCutBoundaryLabel z⟩,
    z.1.pairing.color z.2)

@[simp]
theorem cutToBoundaryLabelled_pairing
    (z : MarkedBoundaryLabelledPairing D r m) :
    (cutToBoundaryLabelled z).1.pairing = z.1.pairing.erase z.2 := rfl

@[simp]
theorem cutToBoundaryLabelled_color
    (z : MarkedBoundaryLabelledPairing D r m) :
    (cutToBoundaryLabelled z).2 = z.1.pairing.color z.2 := rfl

/-- Cutting a boundary-labelled object creates exactly two boundary darts,
including when the original boundary label set is empty. -/
theorem card_boundary_cut [Fintype D]
    (z : MarkedBoundaryLabelledPairing D r m) :
    Fintype.card (z.1.pairing.erase z.2).Boundary = m + 2 := by
  change Fintype.card
      (z.1.pairing.matching.erase z.2).Boundary = m + 2
  rw [z.1.pairing.matching.card_boundary_erase z.2]
  have hcard : Fintype.card z.1.pairing.Boundary = m := by
    simpa using Fintype.card_congr z.1.label
  change Fintype.card z.1.pairing.matching.Boundary = m at hcard
  simpa [hcard]

/-! ## Recovering the selected pair from the two star labels

This is the first half of the inverse to the conventional `m+2`-labelled
cut presentation.  Given a cut pairing labelled by `Fin (m+2)`, the
preimages of the last two labels determine an unordered free pair.  Joining
that pair with the supplied colour and cutting the new seam is proved to
recover the original coloured cut data exactly.
-/

/-- First of the two labels reserved for endpoints exposed by a cut. -/
def firstStar (m : ℕ) : Fin (m + 2) := ⟨m, by omega⟩

/-- Second reserved endpoint label. -/
def secondStar (m : ℕ) : Fin (m + 2) := ⟨m + 1, by omega⟩

theorem firstStar_ne_secondStar (m : ℕ) :
    firstStar m ≠ secondStar m := by
  intro h
  have := congrArg Fin.val h
  simp [firstStar, secondStar] at this

/-- Boundary dart carrying the first star label. -/
def firstStarDart (Q : BoundaryLabelledPairing D r (m + 2)) :
    Q.pairing.Boundary :=
  Q.label.symm (firstStar m)

/-- Boundary dart carrying the second star label. -/
def secondStarDart (Q : BoundaryLabelledPairing D r (m + 2)) :
    Q.pairing.Boundary :=
  Q.label.symm (secondStar m)

theorem firstStarDart_ne_secondStarDart
    (Q : BoundaryLabelledPairing D r (m + 2)) :
    (firstStarDart Q).1 ≠ (secondStarDart Q).1 := by
  intro h
  have hsub : firstStarDart Q = secondStarDart Q := Subtype.ext h
  have hlabels := congrArg Q.label hsub
  apply firstStar_ne_secondStar m
  simpa only [firstStarDart, secondStarDart, Equiv.apply_symm_apply] using hlabels

/-- The unordered free pair selected by the last two boundary labels. -/
def starFreePair (Q : BoundaryLabelledPairing D r (m + 2)) :
    Q.pairing.matching.FreePair where
  pair := s((firstStarDart Q).1, (secondStarDart Q).1)
  free d hd := by
    rcases Sym2.mem_iff.mp hd with h | h
    · simpa [h] using (firstStarDart Q).2
    · simpa [h] using (secondStarDart Q).2
  offDiagonal := by
    rw [Sym2.mk_isDiag_iff]
    exact firstStarDart_ne_secondStarDart Q

/-- Add the colour of the seam which is to be reconstructed. -/
def starFreePairDatum
    (Q : BoundaryLabelledPairing D r (m + 2)) (c : Fin r) :
    Q.pairing.FreePairDatum where
  selected := starFreePair Q
  color := c

/-- Forget the cut boundary labels after using their two star preimages to
select the free pair. -/
def boundaryLabelledToFreePair
    (z : BoundaryLabelledPairing D r (m + 2) × Fin r) :
    ColoredMatching.FreePairColoredMatching D r :=
  ⟨z.1.pairing, starFreePairDatum z.1 z.2⟩

/-- Join the star-selected pair and mark the newly inserted seam. -/
def joinStarsMarked
    (z : BoundaryLabelledPairing D r (m + 2) × Fin r) :
    ColoredMatching.MarkedColoredMatching D r :=
  ColoredMatching.joinSelected (boundaryLabelledToFreePair z)

/-- Exact underlying reassembly: after joining the pair selected by the two
star labels, cutting the distinguished new seam recovers the original
coloured cut matching, the same selected pair, and the supplied colour. -/
theorem cutMarked_joinStarsMarked
    (z : BoundaryLabelledPairing D r (m + 2) × Fin r) :
    ColoredMatching.cutMarked (joinStarsMarked z) =
      boundaryLabelledToFreePair z :=
  ColoredMatching.cutMarked_joinSelected (boundaryLabelledToFreePair z)

@[simp]
theorem cut_joinStars_pairing
    (z : BoundaryLabelledPairing D r (m + 2) × Fin r) :
    (ColoredMatching.cutMarked (joinStarsMarked z)).1 = z.1.pairing := by
  simpa only [boundaryLabelledToFreePair] using
    congrArg Sigma.fst (cutMarked_joinStarsMarked z)

@[simp]
theorem cut_joinStars_color
    (z : BoundaryLabelledPairing D r (m + 2) × Fin r) :
    (ColoredMatching.cutMarked (joinStarsMarked z)).2.color = z.2 := by
  simpa only [boundaryLabelledToFreePair, starFreePairDatum] using
    congrArg (fun w => w.2.color) (cutMarked_joinStarsMarked z)

@[simp]
theorem starFreePair_pair
    (Q : BoundaryLabelledPairing D r (m + 2)) :
    (starFreePair Q).pair =
      s((firstStarDart Q).1, (secondStarDart Q).1) := rfl


end
end LabelledCutJoin
end FacetPairing
end PolytopeCounting
