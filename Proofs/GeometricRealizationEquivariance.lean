module

public import Proofs.GeometricPresentationAction

@[expose] public section

/-!
# Equivariance of the actual simplex quotient

The relation is generated by the specified affine seam maps. Every cellwise
vertex-frame renaming descends to a homeomorphism. The compatibility square
is proved from the explicit two-sided transport law; no abstract
`hforward`/`hbackward` hypotheses are left at the public endpoint.
-/

namespace PolytopeCounting.FacetPairing.GeometricPresentation
noncomputable section
open GeometricFacet SimplexRealization Convexity Renaming.WreathRenaming
universe u
variable {C : Type u} [DecidableEq C] {h : ℕ}

abbrev CellPoints (C : Type u) (h : ℕ) := Σ _ : C, CellSimplex h

def frameHomeomorph (g : Frames C h) : CellPoints C h ≃ₜ CellPoints C h where
  toFun p := ⟨g.cell p.1, simplexHomeomorph (vertexPerm g p.1) p.2⟩
  invFun p := ⟨g.cell.symm p.1,
    (simplexHomeomorph (vertexPerm g (g.cell.symm p.1))).symm p.2⟩
  left_inv p := by
    rcases p with ⟨c,x⟩
    simp
  right_inv p := by
    rcases p with ⟨c,x⟩
    simp
  continuous_toFun := continuous_sigma (fun c ↦
    (continuous_sigmaMk (i := g.cell c)).comp
      (simplexHomeomorph (vertexPerm g c)).continuous)
  continuous_invFun := continuous_sigma (fun c ↦
    (continuous_sigmaMk (i := g.cell.symm c)).comp
      (simplexHomeomorph (vertexPerm g (g.cell.symm c))).symm.continuous)

@[simp] theorem frameHomeomorph_inv (g : Frames C h) :
    frameHomeomorph g⁻¹=(frameHomeomorph g).symm := by
  apply Homeomorph.ext
  intro p
  rcases p with ⟨c,x⟩
  rfl

@[simp] theorem frameHomeomorph_one :
    frameHomeomorph (1 : Frames C h)=Homeomorph.refl (CellPoints C h) := by
  apply Homeomorph.ext
  intro p
  rcases p with ⟨c,x⟩
  change (⟨c,StdSimplex.map id x⟩ : CellPoints C h)=⟨c,x⟩
  rw [StdSimplex.map_id]

/-- Pointwise commutative squares on the actual facets of actual real
simplices. Compatibility is stated before quotienting, so accidental extra
identifications of the quotient do not create presentation isomorphisms. -/
def AffineCompatible (g : Frames C h) (P Q : Presentation C h) : Prop :=
  Q.matching=Renaming.MatchingTransport.renamePartial (slotsPerm g) P.matching ∧
  ∀ a b, s(a,b) ∈ P.matching.seams → ∀ x : FacetSimplex a.2,
    simplexHomeomorph (Q.maps (slotsPerm g a) (slotsPerm g b))
      (simplexHomeomorph (vertexPerm g a.1) (facetInclusion a.2 x)) =
    simplexHomeomorph (vertexPerm g b.1)
      (simplexHomeomorph (P.maps a b) (facetInclusion a.2 x))

/-- Both directions: the geometric squares determine the algebraic maps,
and two-sided transport supplies those squares. -/
theorem affineCompatible_iff_compatible (g : Frames C h) (P Q : Presentation C h) :
    AffineCompatible g P Q ↔ Compatible g P Q := by
  constructor
  · rintro ⟨hm,hf⟩
    refine ⟨hm,?_⟩
    intro a b hab
    have hnew : s(slotsPerm g a,slotsPerm g b) ∈ Q.matching.seams := by
      rw [hm]
      exact (pair_mem_rename (slotsPerm g) P.matching a b).mpr hab
    have hpoint := Q.endpoint (slotsPerm g a) (slotsPerm g b) hnew
    change Q.maps (slotsPerm g a) (slotsPerm g b) (vertexPerm g a.1 a.2) =
      vertexPerm g b.1 b.2 at hpoint
    have he : Q.maps (slotsPerm g a) (slotsPerm g b)*vertexPerm g a.1 =
        vertexPerm g b.1*P.maps a b := by
      apply completed_map_determined_on_facet a.2
      · simpa only [Equiv.Perm.mul_apply,P.endpoint a b hab] using hpoint
      · intro x
        have hx := hf a b hab x
        change StdSimplex.map _ (StdSimplex.map _ (facetInclusion a.2 x)) =
          StdSimplex.map _ (StdSimplex.map _ (facetInclusion a.2 x)) at hx
        change StdSimplex.map (fun v ↦ Q.maps (slotsPerm g a) (slotsPerm g b)
          (vertexPerm g a.1 v)) (facetInclusion a.2 x) =
          StdSimplex.map (fun v ↦ vertexPerm g b.1 (P.maps a b v))
            (facetInclusion a.2 x)
        simpa only [StdSimplex.map_map, Function.comp_def]
          using hx
    calc
      Q.maps (slotsPerm g a) (slotsPerm g b) =
          (Q.maps (slotsPerm g a) (slotsPerm g b)*vertexPerm g a.1)*
            (vertexPerm g a.1)⁻¹ := by simp [mul_assoc]
      _ = vertexPerm g b.1*P.maps a b*(vertexPerm g a.1)⁻¹ := by rw [he]
  · rintro ⟨hm,hg⟩
    refine ⟨hm,?_⟩
    intro a b hab x
    rw [hg a b hab]
    exact transported_gluing_square (g.slot a.1) (g.slot b.1)
      ⟨P.maps a b,P.endpoint a b hab,P.odd_map a b hab⟩ (facetInclusion a.2 x)

/-- Geometric presentation classes are precisely orbits for the constructed
action. This does not classify bare topological quotient spaces. -/
theorem affineCompatible_iff_action (g : Frames C h) (P Q : Presentation C h) :
    AffineCompatible g P Q ↔ g • P=Q :=
  (affineCompatible_iff_compatible g P Q).trans (compatible_iff g P Q)

abbrev AffineIso (P Q : Presentation C h) := {g : Frames C h // AffineCompatible g P Q}

def affineAutomorphismsEquivStabilizer (P : Presentation C h) :
    AffineIso P P ≃ MulAction.stabilizer (Frames C h) P where
  toFun g := ⟨g.1,(affineCompatible_iff_action _ _ _).mp g.2⟩
  invFun g := ⟨g.1,(affineCompatible_iff_action _ _ _).mpr g.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- Each relation uses an actual seam of the unchanged matching carrier. -/
def AffineGlueRel (P : Presentation C h) (x y : CellPoints C h) : Prop :=
  ∃ a b : Slots C h, ∃ hab : s(a,b) ∈ P.matching.seams,
    ∃ t : FacetSimplex a.2,
      x=⟨a.1,facetInclusion a.2 t⟩ ∧
      y=⟨b.1,simplexHomeomorph (P.maps a b) (facetInclusion a.2 t)⟩

abbrev AffineSpace (P : Presentation C h) := Quot (AffineGlueRel P)

def affineCell (P : Presentation C h) (c : C) (x : CellSimplex h) : AffineSpace P :=
  Quot.mk _ ⟨c,x⟩

theorem continuous_affineCell (P : Presentation C h) (c : C) :
    Continuous (affineCell P c) := continuous_quot_mk.comp continuous_sigmaMk

/-- The generator compatibility formerly missing from the general realization. -/
theorem affineGlueRel_rename (g : Frames C h) (P : Presentation C h)
    (x y : CellPoints C h) (hxy : AffineGlueRel P x y) :
    AffineGlueRel (rename g P) (frameHomeomorph g x) (frameHomeomorph g y) := by
  rcases hxy with ⟨a,b,hab,t,rfl,rfl⟩
  let φ : OddFacetMap a.2 b.2 := ⟨P.maps a b,P.endpoint a b hab,P.odd_map a b hab⟩
  let e := facetVertexEquiv (vertexPerm g a.1) (rfl : vertexPerm g a.1 a.2 = _)
  let t' := simplexHomeomorph e t
  have hnew : s(slotsPerm g a,slotsPerm g b) ∈ (rename g P).matching.seams :=
    (pair_mem_rename (slotsPerm g) P.matching a b).mpr hab
  refine ⟨slotsPerm g a,slotsPerm g b,hnew,t',?_,?_⟩
  · change (⟨g.cell a.1,simplexHomeomorph (vertexPerm g a.1)
        (facetInclusion a.2 t)⟩ : CellPoints C h) =
      ⟨g.cell a.1,facetInclusion (vertexPerm g a.1 a.2) t'⟩
    congr 1
    exact (facetInclusion_natural (vertexPerm g a.1) rfl t).symm
  · change (⟨g.cell b.1,simplexHomeomorph (vertexPerm g b.1)
        (simplexHomeomorph (P.maps a b) (facetInclusion a.2 t))⟩ : CellPoints C h) =
      ⟨g.cell b.1,simplexHomeomorph ((rename g P).maps (slotsPerm g a) (slotsPerm g b))
        (facetInclusion (vertexPerm g a.1 a.2) t')⟩
    congr 1
    rw [rename_maps_at g P a b hab,facetInclusion_natural (vertexPerm g a.1) rfl t]
    exact (transported_gluing_square (g.slot a.1) (g.slot b.1) φ
      (facetInclusion a.2 t)).symm

/-- Actual equivariance: the maps are the prescribed cellwise affine maps. -/
def realizationHomeomorph (g : Frames C h) (P : Presentation C h) :
    AffineSpace P ≃ₜ AffineSpace (rename g P) :=
  Realization.quotientHomeomorph (AffineGlueRel P) (AffineGlueRel (rename g P))
    (frameHomeomorph g) (affineGlueRel_rename g P) (by
      intro x y hxy
      have hh := affineGlueRel_rename g⁻¹ (rename g P) x y hxy
      simpa only [← rename_mul,inv_mul_cancel,rename_one,frameHomeomorph_inv] using hh)

@[simp] theorem realizationHomeomorph_cell (g : Frames C h) (P : Presentation C h)
    (c : C) (x : CellSimplex h) :
    realizationHomeomorph g P (affineCell P c x) =
      affineCell (rename g P) (g.cell c) (simplexHomeomorph (vertexPerm g c) x) := rfl

/-- Independently specified presentation isomorphisms really produce
homeomorphisms. The converse for arbitrary homeomorphisms is NOT asserted. -/
def geometricIsoHomeomorph {P Q : Presentation C h} (e : GeometricIso P Q) :
    AffineSpace P ≃ₜ AffineSpace Q := by
  have he : rename e.1 P=Q := (compatible_iff _ _ _).mp e.2
  rw [← he]
  exact realizationHomeomorph e.1 P

/-- Pointwise affine compatibility produces the prescribed quotient
homeomorphism, with no further compatibility certificate. -/
def affineIsoHomeomorph {P Q : Presentation C h} (e : AffineIso P Q) :
    AffineSpace P ≃ₜ AffineSpace Q :=
  geometricIsoHomeomorph ⟨e.1,(affineCompatible_iff_compatible _ _ _).mp e.2⟩

end
end PolytopeCounting.FacetPairing.GeometricPresentation
